    <CrossgenVersion Condition="'$(CrossgenVersion)' == ''">10.0.0</CrossgenVersion>
    <CrossgenRuntimeIdentifier Condition="'$(CrossgenRuntimeIdentifier)' == ''">win-x64</CrossgenRuntimeIdentifier>
