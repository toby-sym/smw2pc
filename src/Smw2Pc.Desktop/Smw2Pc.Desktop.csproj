<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SMW</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\..\..\assets\SMW2PC.ico')">$(MSBuildProjectDirectory)\..\..\assets\SMW2PC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.18.0" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.18.0" />
    <PackageReference Include="SDL3-CS.MacOS.TTF" Version="3.2.2.13" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.18.0" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\fonts\Inter-Variable.ttf" Link="assets\fonts\Inter-Variable.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\OFL.txt" Link="assets\fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smw2Pc.Core\Smw2Pc.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Variable.ttf" LogicalName="Smw2Pc.Desktop.Font" />
  </ItemGroup>

  <ItemGroup Condition="'$(CompiledRomPath)' != ''">
    <EmbeddedResource Include="$(CompiledRomPath)" LogicalName="Smw2Pc.Desktop.CompiledRom" />
  </ItemGroup>

  <ItemGroup Condition="'$(RecompiledSourceDirectory)' != ''">
    <EmbeddedResource Include="$(RecompiledSourceDirectory)\proof.json" LogicalName="Smw2Pc.Desktop.RecompilationProof" />
    <EmbeddedResource Include="$(RecompiledSourceDirectory)\manifest.json" LogicalName="Smw2Pc.Desktop.RecompilationManifest" />
  </ItemGroup>

</Project>
