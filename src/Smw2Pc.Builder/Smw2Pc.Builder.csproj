<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SMW2PC</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Smw2Pc.Recompiler\Smw2Pc.Recompiler.csproj" />
    <PackageReference Include="SDL3-CS" Version="3.4.18.0" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.18.0" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <PackageReference Include="SDL3-CS.MacOS.TTF" Version="3.2.2.13" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.18.0" Condition="'$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.13" Condition="'$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <Reference Include="Microsoft.NET.HostModel"><HintPath>$(MSBuildSDKsPath)\..\Microsoft.NET.HostModel.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Compile Include="..\Smw2Pc.Desktop\UiTextRenderer.cs" Link="UiTextRenderer.cs" />
    <Compile Include="..\Smw2Pc.Desktop\BundledAssets.cs" Link="BundledAssets.cs" />
    <Compile Include="..\Smw2Pc.Desktop\NativeDependencyProof.cs" Link="NativeDependencyProof.cs" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Variable.ttf" LogicalName="Smw2Pc.Desktop.Font" />
    <EmbeddedResource Include="$(BuilderPayloadPath)" LogicalName="Smw2Pc.Builder.Payload.zip" Condition="'$(BuilderPayloadPath)' != ''" />
  </ItemGroup>
</Project>
